{
  "name": "mundo-en-llamas",
  "version": "0.1.0",
  "description": "Mundo en Llamas: juego de estrategia y conquista de territorios para el navegador",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.js\"",
    "build:map": "node scripts/build-map.js",
    "emuladores": "npx --yes firebase-tools@10.9.2 emulators:start --only auth,database --project demo-mundo",
    "deploy-rules": "npx --yes firebase-tools@13.29.1 deploy --only database"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "vite": "^5.4.11",
    "world-atlas": "^2.0.2"
  },
  "dependencies": {
    "@3d-dice/dice-box-threejs": "^0.0.12",
    "firebase": "^10.14.1"
  }
}
